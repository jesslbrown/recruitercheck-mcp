{
  "name": "recruitercheck-mcp",
  "displayName": "RecruiterCheck MCP",
  "description": "MCP server for scam-risk checks on job postings, recruiter emails, and company domains.",
  "version": "0.1.0",
  "repository": "https://github.com/jesslbrown/recruitercheck-mcp",
  "homepage": "https://mcp-server-seven-alpha.vercel.app/",
  "runtime": "node",
  "entrypoint": "apps/mcp-server/dist/index.js",
  "transports": ["stdio", "streamable-http"],
  "httpEndpoint": "https://mcp-server-seven-alpha.vercel.app/mcp",
  "tools": [
    "check_job_posting_legitimacy",
    "check_recruiter_email",
    "check_company_domain",
    "explain_risk_signals"
  ],
  "env": ["SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY"],
  "license": "UNLICENSED"
}
